DATABASE_URL="postgresql://user:password@localhost:5432/routepilot"
JWT_SECRET="change-me-in-production"

# OSRM — driving distance & duration
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=driving

# Redis — BullMQ job queue (start: docker compose up -d redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Python optimizer (apps/optimizer — pip install -r requirements.txt && uvicorn main:app --port 8000)
OPTIMIZER_URL=http://127.0.0.1:8000

WEB_ORIGIN=http://localhost:5173
PORT=3000
