# Database
DATABASE_URL="postgresql://user:password@localhost:5432/routepilot"

# JWT
JWT_SECRET="change-me-in-production"

# OSRM — driving distance & duration (default: public demo server)
# For production, run your own OSRM container and set OSRM_BASE_URL=http://localhost:5000
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=driving
